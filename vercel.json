{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "frontend/dist/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/.*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1",
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "server/index.js"
    }
  ]
}